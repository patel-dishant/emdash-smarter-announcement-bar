{
	"name": "smarter-announcement-bar",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.16.0",
	"main": "dist/native.mjs",
	"exports": {
		".": {
			"import": "./dist/native.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./admin": "./dist/admin/index.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build && node scripts/build-admin.mjs",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run && node scripts/build-admin.mjs",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=0.12.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.4",
		"@emdash-cms/plugin-test": "^0.2.9",
		"@phosphor-icons/react": "^2.1.10",
		"emdash": ">=0.12.0 <1.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
